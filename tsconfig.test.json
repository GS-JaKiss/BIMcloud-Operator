{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "dist-test",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["test/**/*.ts", "src/main/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["dist", "dist-test", "node_modules"]
}